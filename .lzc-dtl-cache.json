{
  "name": "FilePizza",
  "package": "cloud.lazycat.app.filepizza",
  "description": "浏览器中的点对点文件传输",
  "homepage": "https://github.com/kern/filepizza",
  "author": "kern",
  "app_features": [
    "background_task",
    "public_path"
  ],
  "subdomain": "filepizza",
  "version": "2.0.0",
  "public_paths": [
    "/"
  ],
  "iconPath": "icon.png",
  "composePath": "docker-compose.yaml",
  "unsupported_platforms": [],
  "lastRouteType": "from_compose",
  "port_mappings": {
    "redis_6379_6379": {
      "use": true,
      "type": "port",
      "protocol": "tcp"
    },
    "coturn_3478_3478": {
      "use": true,
      "type": "port",
      "protocol": "udp"
    },
    "coturn_5349_5349": {
      "use": true,
      "type": "port",
      "protocol": "udp"
    },
    "filepizza_8080_8080": {
      "use": true,
      "type": "http",
      "path": "/",
      "targetPath": "/"
    }
  },
  "image_redis_latest": {
    "originalImage": "redis:latest",
    "pushTarget": "none"
  },
  "redis_volume_redis_data_/data_action": "emptyDir",
  "redis_volume_/data_location": "app_data",
  "image_coturn_coturn": {
    "originalImage": "coturn/coturn",
    "pushTarget": "none"
  },
  "filepizza_build_or_image": "image",
  "image_kern_filepizza_latest": {
    "originalImage": "kern/filepizza:latest",
    "pushTarget": "none"
  }
}
